<mxfile host="app.diagrams.net" agent="5.0" version="21.0.0">
  <diagram name="Security Design" id="sec-1">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Zero-Knowledge Authentication Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8ff5ff;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 1: Register -->
        <mxCell id="s1-box" value="1. REGISTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#8ff5ff;strokeWidth=2;fontColor=#8ff5ff;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s1-content" value="&#128237; User sets&#xa;Master Password&#xa;&#xa;&#128274; Argon2id Hash&#xa;   → Stored in Firestore&#xa;&#128272; Password NEVER&#xa;   stored anywhere" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="115" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Arrow 1->2 -->
        <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeColor=#00E5FF;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1-box" target="s2-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 2: Login -->
        <mxCell id="s2-box" value="2. LOGIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#00E5FF;strokeWidth=2;fontColor=#00E5FF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s2-content" value="&#128100; User enters&#xa;Master Password&#xa;&#xa;&#128273; Client derives&#xa;   Argon2id hash&#xa;&#128100; Hash compared&#xa;   with stored hash" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="115" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Arrow 2->3 -->
        <mxCell id="a2" value="" style="endArrow=classic;html=1;strokeColor=#FF0A54;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2-box" target="s3-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 3: Vault Access -->
        <mxCell id="s3-box" value="3. VAULT ACCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#FF0A54;strokeWidth=2;fontColor=#FF0A54;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="810" y="100" width="240" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s3-content" value="&#128272; Password-derived&#xa;   key encrypts/decrypts&#xa;   vault entries&#xa;&#xa;&#128274; AES-256-GCM&#xa;   Encrypted data" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="115" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- Bottom: How it works -->
        <mxCell id="bottom-box" value="How It Works" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A1128;strokeColor=#4D00FF;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="1000" height="240" as="geometry"/>
        </mxCell>

        <!-- Encryption detail -->
        <mxCell id="enc-box" value="AES-256-GCM Encryption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#8ff5ff;strokeWidth=1.5;fontColor=#8ff5ff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="enc-items" value="&#128274; Each vault item encrypted individually&#xa;&#128373; Unique IV (Initialization Vector) per item&#xa;&#128200; Nonce + Ciphertext + Tag stored per item&#xa;&#128992; Industry standard — governments &amp; militaries use this" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="365" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- Divider -->
        <mxCell id="div" value="" style="shape=line;strokeColor=#4D00FF;strokeWidth=1;dashed=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="335" width="0" height="190" as="geometry"/>
        </mxCell>

        <!-- Argon2id detail -->
        <mxCell id="arg-box" value="Argon2id Password Hashing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#00E5FF;strokeWidth=1.5;fontColor=#00E5FF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="330" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="arg-items" value="&#128200; Winner of Password Hashing Competition (2015)&#xa;&#128657; Memory-hard: resistant to GPU/ASIC attacks&#xa;   • 64 MB memory&#xa;   • 3 iterations&#xa;   • 4 parallelism lanes&#xa;&#128337; Verification time: &lt;1 second" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="365" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- Divider 2 -->
        <mxCell id="div2" value="" style="shape=line;strokeColor=#4D00FF;strokeWidth=1;dashed=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="335" width="0" height="190" as="geometry"/>
        </mxCell>

        <!-- Zero-knowledge detail -->
        <mxCell id="zk-box" value="Zero-Knowledge Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#FF0A54;strokeWidth=1.5;fontColor=#FF0A54;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="790" y="330" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="zk-items" value="&#128272; Server NEVER sees&#xa;   actual password&#xa;&#128274; Only hash stored&#xa;   in cloud&#xa;&#128273; Password used only&#xa;   locally for key derivation&#xa;&#128991; Even if Firestore&#xa;   is breached,&#xa;   attackers get&#xa;   nothing useful" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="365" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- Slide label -->
        <mxCell id="slide-lbl" value="SLIDE 7 — Security Design Principles" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="560" width="280" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
