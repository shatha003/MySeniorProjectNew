        <mxCell id="nova-col3" value="&#128722; Powered by&#xa;   Grok-4 via&#xa;   OpenRouter API&#xa;&#128176; 5 XP per message" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9D00FF;fontSize=11;fontStyle=1;spacing=10;" vertex="1" parent="1">
