        <mxCell id="nova-col1" value="&#128187; App Knowledge&#xa;   Knows every CHEA feature&#xa;&#127760; Markdown Rendering&#xa;   Code blocks + syntax highlighting&#xa;&#129506; Mermaid Diagrams&#xa;   Visualize security concepts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="180" height="130" as="geometry"/>
