        <mxCell id="ai-game1" value="&#128293; Phishing Dojo — AI Mode&#xa;AI generates unique phishing&#xa;emails each round. Users learn&#xa;patterns, not memorize templates.&#xa;15 XP per round" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;spacing=8;" vertex="1" parent="1">
