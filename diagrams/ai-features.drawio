        <mxCell id="nova-col2" value="&#127468;&#127463; Arabic RTL Support&#xa;   Full bilingual interface&#xa;&#128100; Chat History (Firestore)&#xa;   Picks up where you left off&#xa;&#128272; Topic Bounded&#xa;   Strictly cybersecurity-focused" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="90" width="180" height="130" as="geometry"/>
